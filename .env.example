VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-only (Vercel Function env vars, no VITE_ prefix so they never
# reach the browser bundle) - required for api/whatsapp-webhook.js. Set
# these in the Vercel project settings, not in this file.
# SUPABASE_SERVICE_ROLE_KEY=   # Supabase Project Settings -> API -> service_role key
# WHATSAPP_VERIFY_TOKEN=       # any string you choose - used once during Meta's webhook setup handshake
# WHATSAPP_APP_SECRET=         # Meta App Dashboard -> App Settings -> Basic -> App Secret
