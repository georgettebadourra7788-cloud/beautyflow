# Optional — the PDF cleaning flow works fully offline/client-side without
# any of this. These are only here to prepare for future features (user
# accounts, lifetime purchase / entitlement tracking). Get these values from
# the Firebase Console: Project Settings -> General -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
